# Copy to .env and load it in your shell. Do not commit credentials.
OPENROUTER_API_KEY=
ASSEMBLYAI_API_KEY=

# Live semantic path used by the voice agent.
AGENTIC_JEV_BACKEND=live
AGENTIC_EXTRACTOR=llama
AGENTIC_LLAMA_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional. Defaults are retained in code.
# AGENTIC_GLOBAL_JEV_MODEL=typesafe/jev-1.13
# AGENTIC_LOCAL_JEV_MODEL=typesafe/jev-1.13
# AGENTIC_BROWSER_CONTROLLER=luna
# AGENTIC_LUNA_MODEL=openai/gpt-4.1
# AGENTIC_EXECUTION_BACKEND=desktop
# BROWSER_BACKEND=browser_use
# For a visible local Jev demo, start Chrome on a separate WSL desktop terminal
# as shown in README.md, then set all three variables below. If you change the
# endpoint for an existing BU_NAME, reload that Browser Harness daemon first.
# BROWSER_BACKEND=jev_ultrafast
# BU_NAME=jev_visible
# BU_CDP_URL=http://127.0.0.1:9338
# Gradio runs browser actions on the server; its page does not show a live tab.
# Jev policy uses OPENROUTER_API_KEY via OpenRouter Decisions by default.
# Optional: use TypeSafe directly instead (requires its own key).
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPE_TEXT also reuses OPENROUTER_API_KEY and OpenRouter defaults unless overridden.
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_REASONING=low
# FISH_AUDIO_VOICE=
# FAST_VOICE_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# FISH_AUDIO_ENDPOINT=https://openrouter.ai/api/v1/audio/speech
